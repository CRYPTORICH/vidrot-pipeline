# Host environment for the cloud app. Set these in Fly secrets, not in git.
#   fly secrets set VIDROT_PASSWORD=... VIDROT_SECRET_KEY=... GEMINI_API_KEY=...

# Owner login. Use a long password. Required when the server is public.
VIDROT_PASSWORD=

# Encrypts settings and the Instagram session at rest. Required on a public bind.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VIDROT_SECRET_KEY=

# Veo. The same Gemini key the old GEMINI_API_KEY used.
GEMINI_API_KEY=

# Optional. A blank value means the key above is used.
# GOOGLE_API_KEY=

# Instagram. Leave the password blank if you import session.json in the app.
IG_USERNAME=vidrot.ai
IG_PASSWORD=

# Optional HTTP proxy you control, so Instagram does not see the datacenter IP.
# Example: http://user:pass@100.x.x.x:8080
IG_PROXY=

# Schedule clock. 09:00 means 9:00 in this zone. Default in the app is America/New_York.
VIDROT_TZ=America/New_York

# Closed-app alerts. Leave blank and the in-app status bar is the notification.
# Generate with: vapid --gen   (after pip install pywebpush)
# VIDROT_VAPID_PUBLIC=
# VIDROT_VAPID_PRIVATE=
# VIDROT_VAPID_SUBJECT=mailto:richybeats1@gmail.com

# Data directory. The Docker image sets this to /data, which is the Fly volume.
# VIDROT_DATA=/data

# Cookie Path. Leave unset (or /) when the app is the whole site.
# Set /vidrot when nginx serves the app under that prefix and strips it.
# VIDROT_COOKIE_PATH=/vidrot

# Passkey (Face ID / Touch ID). The origin has no path. On the EC2 host:
# VIDROT_RP_ID=racksrewards.com
# VIDROT_ORIGIN=https://racksrewards.com
