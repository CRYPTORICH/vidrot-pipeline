# vidrot.ai pipeline — copy to .env and fill in what you have.
# Prompt generation needs none of these. They are only for Instagram posting.
# Load them yourself before running (the scripts read the process environment):
#   set -a && source .env && set +a

# Account that receives the Reels. The public account is @vidrot.ai.
IG_USERNAME=vidrot.ai

# Account password. Leave blank if you log in with a session instead.
IG_PASSWORD=

# Path to a session.json produced by a successful local login.
# Also checked automatically:
#   ~/.openclaw/instagram_sessions/session.json
#   config/session.json   (gitignored)
# IG_SESSION_FILE=/absolute/path/to/session.json

# Paste the whole session.json as one line when a file is inconvenient
# (this is the value to store in the GitHub secret IG_SESSION_JSON).
# IG_SESSION_JSON=

# Instagram sessionid cookie, if you have that and not the full session file.
# IG_SESSIONID=

# Current 6-digit authenticator code. Only needed when the account has 2FA
# and you are doing a password login. A reused session file does not need this.
# IG_VERIFICATION_CODE=

# Seconds to wait between clips in a batch. Defaults are 300 and 900.
# IG_POST_DELAY_MIN=300
# IG_POST_DELAY_MAX=900

# Google Trends country code. Default US.
# TRENDS_GEO=US

# Write prompts, captions, and the trend cache here instead of the repo.
# VIDROT_BASE=/tmp/vidrot-out
